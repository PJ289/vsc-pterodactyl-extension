{
    "name": "pterodactyl-sftp",
    "displayName": "Pterodactyl SFTP",
    "description": "Connect to Pterodactyl panel servers, browse and edit files remotely via API",
    "version": "2.0.8",
    "icon": "resources/icon.png",
    "license": "MIT",
    "publisher": "PJ289",
    "author": "PJ289",
    "contributors": [
        "minhmcpc (original)",
        "PJ289 (https://github.com/PJ289)"
    ],
    "engines": {
        "vscode": "^1.125.0"
    },
    "capabilities": {
        "virtualWorkspaces": true
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/PJ289/vsc-pterodactyl-extension.git"
    },
    "bugs": {
        "url": "https://github.com/PJ289/vsc-pterodactyl-extension/issues"
    },
    "homepage": "https://github.com/PJ289/vsc-pterodactyl-extension#readme",
    "keywords": [
        "pterodactyl",
        "sftp",
        "server management",
        "remote",
        "terminal",
        "console"
    ],
    "galleryBanner": {
        "color": "#1e1e3f",
        "theme": "dark"
    },
    "contributes": {
        "configuration": {
            "title": "Pterodactyl SFTP",
            "properties": {
                "pterodactyl.agent.mode": {
                    "type": "string",
                    "enum": ["read-only", "read-write"],
                    "default": "read-only",
                    "description": "Controls whether AI agent MCP/LM tools can modify remote files. Use read-write to allow create, edit, delete, and rename via the agent."
                },
                "pterodactyl.agent.allowedPaths": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "If non-empty, agent write operations are only allowed under these paths (prefix match, e.g. /plugins, /config). Empty = all paths allowed except blockedPaths."
                },
                "pterodactyl.agent.blockedPaths": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": ["/world", "/world_nether", "/world_the_end", "/logs", "/crash-reports", "/cache"],
                    "description": "Remote paths the agent cannot modify (prefix match)."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "pterodactyl-sftp",
                    "title": "Pterodactyl SFTP",
                    "icon": "resources/icon.png"
                }
            ]
        },
        "views": {
            "pterodactyl-sftp": [
                {
                    "id": "pterodactylServers",
                    "name": "Servers",
                    "icon": "resources/icon.png"
                }
            ]
        },
        "commands": [
            {
                "command": "pterodactyl.addAccount",
                "title": "Pterodactyl: Add Account",
                "icon": "$(add)"
            },
            {
                "command": "pterodactyl.editAccount",
                "title": "Pterodactyl: Edit Account",
                "icon": "$(edit)"
            },
            {
                "command": "pterodactyl.removeAccount",
                "title": "Pterodactyl: Remove Account",
                "icon": "$(trash)"
            },
            {
                "command": "pterodactyl.refreshServers",
                "title": "Pterodactyl: Refresh Servers",
                "icon": "$(refresh)"
            },
            {
                "command": "pterodactyl.connectServer",
                "title": "Pterodactyl: Connect to Server",
                "icon": "$(remote)"
            },
            {
                "command": "pterodactyl.disconnectServer",
                "title": "Pterodactyl: Disconnect Server",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "pterodactyl.reconnectServer",
                "title": "Pterodactyl: Reconnect Server",
                "icon": "$(debug-restart)"
            },
            {
                "command": "pterodactyl.openTerminal",
                "title": "Pterodactyl: Open Server Terminal",
                "icon": "$(terminal)"
            },
            {
                "command": "pterodactyl.exportData",
                "title": "Pterodactyl: Export Account Data",
                "icon": "$(cloud-download)"
            },
            {
                "command": "pterodactyl.importData",
                "title": "Pterodactyl: Import Account Data",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "pterodactyl.setupSshKey",
                "title": "Pterodactyl: Setup Auto SSH Key",
                "icon": "$(key)"
            },
            {
                "command": "pterodactyl.showSftpLog",
                "title": "Pterodactyl: Show SFTP Debug Log",
                "icon": "$(output)"
            },
            {
                "command": "pterodactyl.configureSftpHost",
                "title": "Configure SFTP Host",
                "icon": "$(edit)"
            },
            {
                "command": "pterodactyl.startServer",
                "title": "Start Server",
                "icon": "$(play)"
            },
            {
                "command": "pterodactyl.restartServer",
                "title": "Restart Server",
                "icon": "$(debug-restart)"
            },
            {
                "command": "pterodactyl.stopServer",
                "title": "Stop Server",
                "icon": "$(debug-stop)"
            },
            {
                "command": "pterodactyl.killServer",
                "title": "Kill Server",
                "icon": "$(flame)"
            },
            {
                "command": "pterodactyl.setupAgentMcp",
                "title": "Pterodactyl: Setup Agent MCP",
                "icon": "$(sparkle)"
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "pterodactyl-sftp",
                "label": "Pterodactyl SFTP"
            }
        ],
        "languageModelTools": [
            {
                "name": "pterodactyl-sftp_list_servers",
                "displayName": "List Connected Pterodactyl Servers",
                "modelDescription": "Returns all Pterodactyl game servers that are currently connected and mounted in the workspace. Always call this first to get valid serverId values before using other Pterodactyl tools.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroServers",
                "icon": "$(server)"
            },
            {
                "name": "pterodactyl-sftp_list_directory",
                "displayName": "List Remote Directory",
                "modelDescription": "Lists files and subdirectories at a path on a connected Pterodactyl server. Returns name and type (file/directory/symlink) for each entry. Use to explore the remote file system.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroList",
                "icon": "$(folder-opened)",
                "inputSchema": {
                    "type": "object",
                    "required": [
                        "serverId"
                    ],
                    "properties": {
                        "serverId": {
                            "type": "string",
                            "description": "Server identifier from pteroServers"
                        },
                        "path": {
                            "type": "string",
                            "default": "/",
                            "description": "Remote path to list"
                        }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_read_file",
                "displayName": "Read Remote File",
                "modelDescription": "Reads the contents of a single file from a connected Pterodactyl server without downloading it. Returns content (utf8 text or base64 for binary) and encoding.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroRead",
                "icon": "$(file-text)",
                "inputSchema": {
                    "type": "object",
                    "required": [
                        "serverId",
                        "path"
                    ],
                    "properties": {
                        "serverId": {
                            "type": "string",
                            "description": "Server identifier from pteroServers"
                        },
                        "path": {
                            "type": "string",
                            "description": "Remote file path, e.g. /server.properties"
                        }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_get_file_tree",
                "displayName": "Get Remote File Tree",
                "modelDescription": "Returns a recursive tree of file and directory names for a path on a Pterodactyl server. Use to understand the server's directory structure. Heavy directories like logs are excluded by default.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroTree",
                "icon": "$(list-tree)",
                "inputSchema": {
                    "type": "object",
                    "required": [
                        "serverId"
                    ],
                    "properties": {
                        "serverId": {
                            "type": "string",
                            "description": "Server identifier from pteroServers"
                        },
                        "path": {
                            "type": "string",
                            "default": "/",
                            "description": "Root path for the tree"
                        },
                        "maxDepth": {
                            "type": "integer",
                            "default": 3,
                            "minimum": 1,
                            "maximum": 8
                        },
                        "excludes": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Directory names to skip"
                        }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_search_text",
                "displayName": "Search Text in Remote Files",
                "modelDescription": "Searches for a regex pattern inside text files on a connected Pterodactyl server. Returns file path, line number, and matched line for each result. Binary files and files over 2 MB are skipped.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroSearch",
                "icon": "$(search)",
                "inputSchema": {
                    "type": "object",
                    "required": [
                        "serverId",
                        "pattern"
                    ],
                    "properties": {
                        "serverId": {
                            "type": "string",
                            "description": "Server identifier from pteroServers"
                        },
                        "pattern": {
                            "type": "string",
                            "description": "JavaScript regex pattern to search for"
                        },
                        "path": {
                            "type": "string",
                            "default": "/",
                            "description": "Directory to search in"
                        },
                        "maxFiles": {
                            "type": "integer",
                            "default": 200,
                            "maximum": 500
                        },
                        "maxMatches": {
                            "type": "integer",
                            "default": 50,
                            "maximum": 200
                        }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_get_permissions",
                "displayName": "Get Agent Permissions",
                "modelDescription": "Returns current agent permission settings: mode, allowedPaths, blockedPaths, writeEnabled. Call before write operations.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroPerms",
                "icon": "$(shield)"
            },
            {
                "name": "pterodactyl-sftp_write_file",
                "displayName": "Write Remote File",
                "modelDescription": "Creates or overwrites a file on a connected Pterodactyl server. Requires read-write mode and an allowed path.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroWrite",
                "icon": "$(edit)",
                "inputSchema": {
                    "type": "object",
                    "required": ["serverId", "path", "content"],
                    "properties": {
                        "serverId": { "type": "string" },
                        "path": { "type": "string" },
                        "content": { "type": "string" },
                        "encoding": { "type": "string", "enum": ["utf8", "base64"], "default": "utf8" },
                        "create": { "type": "boolean", "default": true }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_delete_path",
                "displayName": "Delete Remote Path",
                "modelDescription": "Deletes a file or directory on a connected Pterodactyl server. Requires read-write mode and an allowed path.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroDelete",
                "icon": "$(trash)",
                "inputSchema": {
                    "type": "object",
                    "required": ["serverId", "path"],
                    "properties": {
                        "serverId": { "type": "string" },
                        "path": { "type": "string" },
                        "recursive": { "type": "boolean", "default": false }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_create_directory",
                "displayName": "Create Remote Directory",
                "modelDescription": "Creates a directory on a connected Pterodactyl server. Requires read-write mode and an allowed path.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroMkdir",
                "icon": "$(new-folder)",
                "inputSchema": {
                    "type": "object",
                    "required": ["serverId", "path"],
                    "properties": {
                        "serverId": { "type": "string" },
                        "path": { "type": "string" }
                    }
                }
            },
            {
                "name": "pterodactyl-sftp_rename_path",
                "displayName": "Rename Remote Path",
                "modelDescription": "Renames or moves a file/directory on a connected Pterodactyl server. Both paths must be allowed.",
                "canBeReferencedInPrompt": true,
                "toolReferenceName": "pteroRename",
                "icon": "$(rename)",
                "inputSchema": {
                    "type": "object",
                    "required": ["serverId", "oldPath", "newPath"],
                    "properties": {
                        "serverId": { "type": "string" },
                        "oldPath": { "type": "string" },
                        "newPath": { "type": "string" }
                    }
                }
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "pterodactyl.addAccount",
                    "when": "view == pterodactylServers",
                    "group": "navigation@1"
                },
                {
                    "command": "pterodactyl.setupSshKey",
                    "when": "view == pterodactylServers",
                    "group": "navigation@3"
                },
                {
                    "command": "pterodactyl.refreshServers",
                    "when": "view == pterodactylServers",
                    "group": "navigation@2"
                },
                {
                    "command": "pterodactyl.exportData",
                    "when": "view == pterodactylServers",
                    "group": "overflow@1"
                },
                {
                    "command": "pterodactyl.importData",
                    "when": "view == pterodactylServers",
                    "group": "overflow@2"
                },
                {
                    "command": "pterodactyl.showSftpLog",
                    "when": "view == pterodactylServers",
                    "group": "overflow@3"
                },
                {
                    "command": "pterodactyl.setupAgentMcp",
                    "when": "view == pterodactylServers",
                    "group": "overflow@4"
                }
            ],
            "view/item/context": [
                {
                    "command": "pterodactyl.editAccount",
                    "when": "view == pterodactylServers && viewItem == account",
                    "group": "inline@1"
                },
                {
                    "command": "pterodactyl.removeAccount",
                    "when": "view == pterodactylServers && viewItem == account",
                    "group": "inline@2"
                },
                {
                    "command": "pterodactyl.connectServer",
                    "when": "view == pterodactylServers && viewItem =~ /server.*/",
                    "group": "inline@1"
                },
                {
                    "command": "pterodactyl.startServer",
                    "when": "view == pterodactylServers && viewItem == server-offline",
                    "group": "inline@2"
                },
                {
                    "command": "pterodactyl.restartServer",
                    "when": "view == pterodactylServers && viewItem =~ /server-(running|starting|stopping)/",
                    "group": "inline@2"
                },
                {
                    "command": "pterodactyl.stopServer",
                    "when": "view == pterodactylServers && viewItem =~ /server-(running|starting)/",
                    "group": "inline@3"
                },
                {
                    "command": "pterodactyl.killServer",
                    "when": "view == pterodactylServers && viewItem == server-stopping",
                    "group": "inline@4"
                },
                {
                    "command": "pterodactyl.killServer",
                    "when": "view == pterodactylServers && viewItem =~ /server-(running|starting|stopping)/",
                    "group": "context@5"
                },
                {
                    "command": "pterodactyl.disconnectServer",
                    "when": "view == pterodactylServers && viewItem =~ /server.*/",
                    "group": "context@1"
                },
                {
                    "command": "pterodactyl.reconnectServer",
                    "when": "view == pterodactylServers && viewItem =~ /server.*/",
                    "group": "context@2"
                },
                {
                    "command": "pterodactyl.openTerminal",
                    "when": "view == pterodactylServers && viewItem =~ /server.*/",
                    "group": "context@3"
                },
                {
                    "command": "pterodactyl.configureSftpHost",
                    "when": "view == pterodactylServers && viewItem =~ /server.*/",
                    "group": "context@4"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "npm run compile && vsce package"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/ssh2": "^1.15.5",
        "@types/vscode": "^1.125.0",
        "@types/ws": "^8.5.10",
        "@vscode/vsce": "^3.7.1",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "ssh2": "^1.15.0",
        "ws": "^8.16.0"
    }
}
